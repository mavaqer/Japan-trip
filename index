<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Japan Quest Log</title>
    <script src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&libraries=places"></script>
    <style>
        :root {
            --bg: #0d0d12;
            --card-bg: #1a1a24;
            --accent: #ff0055;
            --text: #e0e0e0;
            --eat: #ff9f43;
            --drink: #00d2ff;
            --visit: #1dd1a1;
        }

        body {
            font-family: 'Segoe UI', Roboto, -apple-system, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            padding-bottom: 120px;
        }

        header {
            text-align: center;
            border-bottom: 2px solid var(--accent);
            margin-bottom: 20px;
            padding-bottom: 10px;
        }

        h1 { margin: 0; letter-spacing: 2px; color: var(--accent); text-transform: uppercase; font-size: 1.5rem; }

        .input-group {
            background: var(--card-bg);
            padding: 15px;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            border: 1px solid #333;
        }

        input, select, button {
            padding: 14px;
            border-radius: 8px;
            border: none;
            outline: none;
            font-size: 16px; /* Prevents iOS zoom on focus */
        }

        input { background: #2a2a3a; color: white; width: calc(100% - 28px); }
        select { background: #2a2a3a; color: white; cursor: pointer; }
        
        button#add-btn {
            background: var(--accent);
            color: white;
            font-weight: bold;
            text-transform: uppercase;
            cursor: pointer;
            transition: transform 0.1s;
        }

        button#add-btn:active { transform: scale(0.98); }

        .filters {
            display: flex;
            justify-content: space-around;
            margin: 20px 0;
            gap: 8px;
        }

        .filter-btn {
            background: rgba(255,255,255,0.05);
            color: var(--text);
            border: 1px solid #444;
            font-size: 12px;
            flex: 1;
            padding: 8px;
        }

        .filter-btn.active { border-color: var(--accent); background: rgba(255, 0, 85, 0.2); }

        #location-list { display: flex; flex-direction: column; gap: 15px; }

        .location-card {
            background: var(--card-bg);
            padding: 15px;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            border-left: 6px solid transparent;
            transition: 0.3s;
            position: relative;
        }

        .location-card.cat-eat { border-left-color: var(--eat); }
        .location-card.cat-drink { border-left-color: var(--drink); }
        .location-card.cat-visit { border-left-color: var(--visit); }

        .card-header { display: flex; justify-content: space-between; align-items: flex-start; }
        .info h3 { margin: 0 0 5px 0; font-size: 18px; color: #fff; max-width: 200px; }
        .info p { margin: 0; font-size: 13px; opacity: 0.6; line-height: 1.4; }

        .actions { display: flex; gap: 10px; margin-top: 15px; border-top: 1px solid #333; padding-top: 10px; }
        
        .btn-sm {
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: bold;
            flex: 1;
            text-align: center;
            text-decoration: none;
        }

        .check-btn { background: #2ecc71; color: white; }
        .map-btn { background: #3498db; color: white; }
        .del-btn { background: transparent; color: #ff4444; flex: 0.2; }

        .visited { opacity: 0.4; filter: grayscale(0.8); }
        .visited .check-btn { background: #666; }

        .stats {
            position: fixed; bottom: 0; left: 0; right: 0;
            background: rgba(13, 13, 18, 0.95); padding: 20px; 
            text-align: center; font-size: 14px; border-top: 2px solid var(--accent);
            backdrop-filter: blur(10px);
        }

        /* Google Autocomplete styling fix */
        .pac-container {
            background-color: #2a2a3a;
            border-bottom-left-radius: 8px;
            border-bottom-right-radius: 8px;
            border: none;
            font-family: sans-serif;
        }
        .pac-item { color: #ccc; border-top: 1px solid #444; padding: 8px; }
        .pac-item-query { color: white; }
    </style>
</head>
<body>

<header>
    <h1>Japan Quest Log</h1>
</header>

<div class="input-group">
    <input type="text" id="autocomplete" placeholder="Search Place or Address in Japan...">
    <select id="loc-cat">
        <option value="eat">🍽️ Eat / Food</option>
        <option value="drink">🍺 Drink / Nightlife</option>
        <option value="visit">⛩️ Visit / Sightseeing</option>
    </select>
    <button id="add-btn">Add to Itinerary</button>
</div>

<div class="filters">
    <button class="filter-btn active" id="f-all" onclick="setFilter('all')">All</button>
    <button class="filter-btn" id="f-eat" onclick="setFilter('eat')">Eat</button>
    <button class="filter-btn" id="f-drink" onclick="setFilter('drink')">Drink</button>
    <button class="filter-btn" id="f-visit" onclick="setFilter('visit')">Visit</button>
</div>

<div id="location-list"></div>

<div class="stats" id="stats-display">
    Quest Progress: 0/0 Visited
</div>

<script>
    let locations = JSON.parse(localStorage.getItem('japan_quest_v2')) || [];
    let currentFilter = 'all';
    let selectedPlaceData = null;

    // Initialize Google Autocomplete
    function initAutocomplete() {
        const input = document.getElementById('autocomplete');
        const options = {
            componentRestrictions: { country: "jp" },
            fields: ["name", "formatted_address", "geometry", "url"]
        };
        const autocomplete = new google.maps.places.Autocomplete(input, options);

        autocomplete.addListener("place_changed", () => {
            const place = autocomplete.getPlace();
            if (!place.geometry) return;
            selectedPlaceData = {
                name: place.name,
                address: place.formatted_address,
                url: place.url || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.name + " " + place.formatted_address)}`
            };
        });
    }

    // Save and Render
    function saveData() {
        localStorage.setItem('japan_quest_v2', JSON.stringify(locations));
        render();
    }

    document.getElementById('add-btn').addEventListener('click', () => {
        const nameVal = document.getElementById('autocomplete').value;
        if (!nameVal) return;

        const newLoc = {
            id: Date.now(),
            name: selectedPlaceData ? selectedPlaceData.name : nameVal,
            address: selectedPlaceData ? selectedPlaceData.address : "Manual Entry",
            url: selectedPlaceData ? selectedPlaceData.url : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(nameVal)}`,
            cat: document.getElementById('loc-cat').value,
            visited: false
        };

        locations.push(newLoc);
        document.getElementById('autocomplete').value = '';
        selectedPlaceData = null;
        saveData();
    });

    function toggleVisited(id) {
        locations = locations.map(l => l.id === id ? {...l, visited: !l.visited} : l);
        saveData();
    }

    function deleteLoc(id) {
        if(confirm("Remove this place?")) {
            locations = locations.filter(l => l.id !== id);
            saveData();
        }
    }

    function setFilter(f) {
        currentFilter = f;
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('f-' + f).classList.add('active');
        render();
    }

    function render() {
        const listDiv = document.getElementById('location-list');
        listDiv.innerHTML = '';
        
        let displayList = currentFilter === 'all' ? locations : locations.filter(l => l.cat === currentFilter);
        
        // Sort: Unvisited first
        displayList.sort((a, b) => a.visited - b.visited);

        displayList.forEach(loc => {
            const card = document.createElement('div');
            card.className = `location-card cat-${loc.cat} ${loc.visited ? 'visited' : ''}`;
            card.innerHTML = `
                <div class="card-header">
                    <div class="info">
                        <h3>${loc.name}</h3>
                        <p>${loc.address}</p>
                    </div>
                </div>
                <div class="actions">
                    <button class="btn-sm check-btn" onclick="toggleVisited(${loc.id})">
                        ${loc.visited ? 'REVISIT' : 'VISITED'}
                    </button>
                    <a href="${loc.url}" target="_blank" class="btn-sm map-btn">GO TO MAP</a>
                    <button class="btn-sm del-btn" onclick="deleteLoc(${loc.id})">🗑️</button>
                </div>
            `;
            listDiv.appendChild(card);
        });

        const visitedCount = locations.filter(l => l.visited).length;
        document.getElementById('stats-display').innerText = `Quest Progress: ${visitedCount} / ${locations.length} Visited`;
    }

    // Load Google script dynamically or handle errors if no API key
    window.onload = () => {
        if (typeof google !== 'undefined') {
            initAutocomplete();
        } else {
            document.getElementById('autocomplete').placeholder = "Enter place name (Map API Key missing)";
        }
        render();
    };
</script>

</body>
</html>
